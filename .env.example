# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trade_ai_doctor?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3000
NODE_ENV=development
API_PREFIX=api

# CORS (comma-separated origins; leave empty for permissive local development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM — DeepSeek first. Never commit real keys.
LLM_PROVIDER=deepseek
LLM_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
AI_TIMEOUT=30000
AI_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30000
LLM_MAX_RETRIES=2
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=

APP_ENV=development
MIC_DATA_MODE=fixture
DRY_RUN=true
PILOT_PRODUCT_LIMIT=20
PILOT_INQUIRY_LIMIT=50
PARSER_ACCURACY_ABORT=0.8
PARSER_DEBUG=false
MIC_SAFE_EXPAND=false
BACKUP_DIR=./backups

# Frontends
VITE_API_BASE_URL=http://localhost:3000/api
