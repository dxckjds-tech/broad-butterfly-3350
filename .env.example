# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trade_ai_doctor?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3000
NODE_ENV=development
API_PREFIX=api

# CORS (comma-separated origins; leave empty for permissive local development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM — Phase 1 uses mock only. Do not put real keys in source control.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Frontends
VITE_API_BASE_URL=http://localhost:3000/api
