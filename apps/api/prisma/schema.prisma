generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  shops     Shop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shop {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        String
  companyName     String
  shopUrl         String
  lastDiagnosisAt DateTime?
  products        Product[]
  reports         DiagnosisReport[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([platform, companyName])
}

model Product {
  id                String             @id @default(cuid())
  shopId            String
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  platformProductId String?
  name              String
  url               String
  category          String?
  reports           DiagnosisReport[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([shopId])
  @@index([url])
}

model DiagnosisReport {
  id          String            @id @default(cuid())
  shopId      String
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  pageUrl     String
  pageType    String
  totalScore  Int
  rawPageData Json
  score       DiagnosisScore?
  issues      DiagnosisIssue[]
  createdAt   DateTime          @default(now())

  @@index([shopId])
  @@index([productId])
  @@index([createdAt])
}

model DiagnosisScore {
  id                String          @id @default(cuid())
  diagnosisReportId String          @unique
  report            DiagnosisReport @relation(fields: [diagnosisReportId], references: [id], onDelete: Cascade)
  micSeo            Int
  googleSeo         Int
  geo               Int
  contentQuality    Int
  b2bConversion     Int
  compliance        Int?
}

model DiagnosisIssue {
  id                String          @id @default(cuid())
  diagnosisReportId String
  report            DiagnosisReport @relation(fields: [diagnosisReportId], references: [id], onDelete: Cascade)
  category          String
  severity          String
  title             String
  description       String
  suggestion        String
  scoreImpact       Int
  createdAt         DateTime        @default(now())

  @@index([diagnosisReportId])
  @@index([severity])
}
