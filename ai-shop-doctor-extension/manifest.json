{
  "manifest_version": 3,
  "name": "AI 店铺医生 · MIC 运营系统",
  "version": "1.0.0",
  "description": "面向 Made-in-China.com 外贸运营人员的商品理解与运营决策系统",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://made-in-china.com/*", "https://*.made-in-china.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI 店铺医生",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://made-in-china.com/*", "https://*.made-in-china.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["admin/index.html", "admin/opportunities.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
